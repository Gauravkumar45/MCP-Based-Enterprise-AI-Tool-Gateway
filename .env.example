# Application Environment
APP_ENV=development
APP_NAME=MCP-Enterprise-Tool-Gateway
APP_PORT=8080
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mcp_gateway
DATABASE_READONLY_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mcp_gateway
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT & Security Configuration
JWT_SECRET=super-secret-jwt-key-change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# LLM Configuration (Modular)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# MCP Server Configuration
MCP_SERVER_NAME=enterprise-tool-gateway
MCP_SERVER_VERSION=1.0.0
