# Application Environment
APP_ENV=development
APP_NAME=MCP-Enterprise-Tool-Gateway
APP_PORT=8080
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mcp_gateway
DATABASE_READONLY_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mcp_gateway
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT & Security Configuration
JWT_SECRET=super-secret-jwt-key-change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=mcp-enterprise-tool-gateway
JWT_AUDIENCE=mcp-enterprise-tool-gateway

# Authentication Hardening
# Demo shortcuts accept username aliases (bob, alice) and demo password variants.
# Local demos only: the gateway refuses to start with this enabled when APP_ENV=production.
AUTH_DEMO_SHORTCUTS=true
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=300

# HTTP Security (JSON list of allowed browser origins; '*' is rejected in production)
CORS_ALLOWED_ORIGINS=["http://localhost:8501","http://localhost:3000"]
SECURITY_HEADERS_ENABLED=true

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# LLM Configuration (Modular)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# MCP Server Configuration
MCP_SERVER_NAME=enterprise-tool-gateway
MCP_SERVER_VERSION=1.0.0
